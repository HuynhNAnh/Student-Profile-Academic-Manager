<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Tiêu đề ứng dụng -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="STUDENT PROFILE &amp; ACADEMIC MANAGER"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Phần 1: Thẻ Hồ sơ Sinh viên -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Ảnh đại diện -->
                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_default_avatar" />

                <!-- Tên sinh viên -->
                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Huỳnh Ngọc Anh"
                    android:textColor="@color/text_white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Chi tiết MSSV & Lớp -->
                <TextView
                    android:id="@+id/tvStudentDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="MSSV: 2415053122202  •  Lớp: 24T2"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Email sinh viên -->
                <TextView
                    android:id="@+id/tvStudentEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Email: anhsieu572@gmail.com"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Huy hiệu GPA & Xếp loại (Tự mở rộng 1: Đổi màu chữ động) -->
                <TextView
                    android:id="@+id/tvGpaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@color/badge_gpa_bg"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="3.75 GPA  •  Xuất sắc"
                    android:textColor="@color/badge_gpa_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Nhãn vinh danh sinh viên tiêu biểu -->
                <TextView
                    android:id="@+id/tvHonorBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="⭐ Sinh viên Vinh danh (Honor Student)"
                    android:textColor="@color/honor_gold"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Phần 2: Form Thao tác & Các Nút Hành Động -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cập nhật điểm GPA"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Ô nhập điểm GPA -->
                <EditText
                    android:id="@+id/edtGpaInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/text_secondary"
                    android:hint="Nhập GPA mới (0.0 - 4.0)"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />

                <!-- Xem trước xếp loại học lực realtime -->
                <TextView
                    android:id="@+id/tvPreviewRanking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Dự kiến: Xuất sắc"
                    android:textColor="@color/badge_gpa_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Nút chính: Cập Nhật Điểm GPA -->
                <Button
                    android:id="@+id/btnUpdateGpa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/btn_update"
                    android:text="Cập Nhật Điểm GPA"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Nút phụ: Khôi Phục Mặc Định (Tự mở rộng 2: Kèm Dialog xác nhận) -->
                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/btn_reset"
                    android:text="Khôi Phục Mặc Định"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <!-- Nút mở rộng 3: Gửi Báo Cáo Học Tập (Implicit Intent) -->
                <Button
                    android:id="@+id/btnSendReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/btn_cyan"
                    android:text="Gửi Báo Cáo Học Tập"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>